void handleRelay4(AdafruitIO_Data *data) {
  Serial.print("relay Feed 4: ");
  Serial.println(data->value());

  if (data->toInt() == 1) {
    led4state=1;
    digitalWrite(relay4, HIGH);
    Serial.println("relay4 ON");
  } else {
    led4state=0;
    digitalWrite(relay4, LOW);
    Serial.println("relay4 OFF");
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(relay1, OUTPUT);
  pinMode(relay2, OUTPUT);
  pinMode(relay3, OUTPUT);
  pinMode(relay4, OUTPUT);

  pinMode(button1,INPUT);
  pinMode(button2,INPUT);
  pinMode(button3,INPUT);
  pinMode(button4,INPUT);

  Serial.print("Connecting to Adafruit IO");
  io.connect();

  // Attach callback functions
  relayFeed1->onMessage(handleRelay1);
  relayFeed2->onMessage(handleRelay2);
  relayFeed3->onMessage(handleRelay3);
  relayFeed4->onMessage(handleRelay4);

  // Wait for connection
  while (io.status() < AIO_CONNECTED) {
    Serial.print(".");
    delay(500);
  }

  Serial.println();
  Serial.println("Connected to Adafruit IO");
}

void loop() {
  io.run();  // Maintain MQTT connection
  if(digitalRead(button1))
  {
      led1state= !led1state;
      digitalWrite(relay1,led1state);
      relayFeed1 ->save(led1state);
      delay(500);    
  }

   if(digitalRead(button2))
  {
      led2state= !led2state;
      digitalWrite(relay2,led2state);
      relayFeed2 ->save(led2state);
      delay(500);    
  }

   if(digitalRead(button3))
  {
      led3state= !led3state;
      digitalWrite(relay3,led3state);
      relayFeed3 ->save(led3state);
      delay(500);    
  }

   if(digitalRead(button4))
  {
      led4state= !led4state;
      digitalWrite(relay4,led4state);
      relayFeed4 ->save(led4state);
      delay(500);    
  }
}

  
