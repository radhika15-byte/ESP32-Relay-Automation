int  led1state=0;
int  led2state=0;
int  led3state=0;
int  led4state=0;

#include "WiFi.h"
#include "AdafruitIO_WiFi.h"

// ------------ WiFi ------------
#define WIFI_SSID       "Radhika"
#define WIFI_PASS       "123456789"

// ------------ Adafruit IO ------------
#define IO_USERNAME    "Radhika_Narute"
#define IO_KEY         "aio_fnCN07nJbvYukTIkK0pnBpc0xEk8"

AdafruitIO_WiFi io(IO_USERNAME, IO_KEY, WIFI_SSID, WIFI_PASS);

// Create feeds
AdafruitIO_Feed *relayFeed1 = io.feed("Relay1");
AdafruitIO_Feed *relayFeed2  = io.feed("Relay2");
AdafruitIO_Feed *relayFeed3 = io.feed("Relay3");
AdafruitIO_Feed *relayFeed4  = io.feed("Relay4");

// LED pins
#define relay1 2
#define relay2 5
#define relay3 14
#define relay4 15

#define button1 32
#define button2 33
#define button3 34
#define button4 35

// ---------------- CALLBACK FOR LEDs ----------------
void handleRelay1(AdafruitIO_Data *data) {
  Serial.print("relay Feed 1: ");
  Serial.println(data->value());

  if (data->toInt() == 1) {
    led1state=1;
    digitalWrite(relay1, HIGH);
    Serial.println("relay1 ON");
  } else {
     led1state=0;
    digitalWrite(relay1, LOW);
    Serial.println("relay1 OFF");
  }
}

void handleRelay2(AdafruitIO_Data *data) {
  Serial.print("relay Feed 2: ");
  Serial.println(data->value());

  if (data->toInt() == 1) {
    led2state=1;
    digitalWrite(relay2, HIGH);
    Serial.println("relay2 ON");
  } else {
    led2state=0;
    digitalWrite(relay2, LOW);
    Serial.println("relay2 OFF");
  }
}

void handleRelay3(AdafruitIO_Data *data) {
  Serial.print("relay Feed 3: ");
  Serial.println(data->value());

  if (data->toInt() == 1) {
    led3state=1;
    digitalWrite(relay3, HIGH);
    Serial.println("relay3 ON");
  } else {
    led3state=0;
    digitalWrite(relay3, LOW);
    Serial.println("relay3 OFF");
  }
